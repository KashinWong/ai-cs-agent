# ==== LLM 网关（唯一必填两项）====
LLM_GATEWAY_BASE_URL=https://your-openai-compatible-gateway/v1
LLM_GATEWAY_API_KEY=sk-xxxxxxxx
LLM_CHAT_MODEL=deepseek-v4-flash

# ==== 基础设施（compose 内置默认，本地直连时可改 localhost）====
MYSQL_DSN=mysql+aiomysql://ai:ai@mysql:3306/ai_cs
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ==== embedding（本地 fastembed，无需网关 embedding 能力）====
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# ==== 坐席 seed（首次启动写入默认坐席）====
SEED_AGENT_USERNAME=agent
SEED_AGENT_PASSWORD=agent123

# ==== 安全 ====
JWT_SECRET=change-me-please
JWT_EXPIRE_HOURS=8

# ==== 检索 / 引擎默认 ====
DEFAULT_RETRIEVAL_THRESHOLD=0.35
DEFAULT_TOP_K=5

# ==== 开关（多租户开通默认关闭，超出本里程碑范围）====
ENABLE_TENANT_PROVISIONING=false
